# HERMES WATCHDOG — configuration (copier ce fichier vers watchdog/.env)

# ── TELEGRAM (guide pas-à-pas dans WATCHDOG_REPORT.md) ──────────────────────
# 1. Dans Telegram, parler à @BotFather -> /newbot -> suivre les questions.
#    BotFather donne un TOKEN du type 123456789:AAH6h1s...
# 2. Envoyer un message quelconque à ton nouveau bot (bouton START).
# 3. Ouvrir https://api.telegram.org/bot<TON_TOKEN>/getUpdates dans le
#    navigateur : le champ "chat":{"id": 123456789} est ton CHAT_ID.
# 4. Renseigner les deux valeurs ci-dessous et relancer le watchdog.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── MODE URGENCE (décision SIMO — défaut : OFF) ─────────────────────────────
# false (défaut) : le watchdog ALERTE seulement, n'envoie JAMAIS d'ordre.
# true : sur ALERTE CRITIQUE "position sur symbole interdit" (vérification 1)
#        UNIQUEMENT, le watchdog ferme cette position illégitime via un
#        order_send de clôture dédié, loggé [WATCHDOG_FORCE_CLOSE].
#        Tout le reste demeure alerte-seulement quoi qu'il arrive.
WATCHDOG_EMERGENCY_CLOSE=false
