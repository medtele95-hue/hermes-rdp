# Python artifacts
__pycache__/
*.pyc
.pytest_cache/

# Runtime noise (root-level logs and dumps from old runs stay tracked; new ones ignored)
*.log
*.bak
runtime_*.txt
pilot_*.txt
report_*.txt
logs/
watchdog/heartbeat.txt
