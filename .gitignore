# Sentinelle : artefacts runtime (etat anti-bruit + log). Le CODE est suivi.
sentinelle/state.json
sentinelle/sentinelle.log
sentinelle/__pycache__/

# Local backups produced by the daily backup job
backups/

# Learning dataset: preserved by the daily backup job, not by git
app/data/decision_dataset.jsonl
app/data/position_closed_seen.json
app/data/hermes_instance_*.lock
app/data/exit_v2_state.json
app/data/active_symbols.json
# etat runtime du tracker d'outcomes (reecrit a chaque tick) — jamais committe
app/data/outcome_tracker_state.json

# P0-1 (2026-07-13) — SECRETS : ces deux fichiers portent HERMES_INGEST_SECRET
# en clair. Ils etaient SUIVIS par git et ont ete POUSSES sur origin (GitHub)
# depuis le commit b32bf50a du 2026-06-20. Ils sont desormais dessuivis.
# .env.example / watchdog/.env.example restent suivis : ce sont des gabarits
# a valeurs placeholder, sans aucun secret.
.env
.env.readonly.backup
logs/active_profile.txt
logs/stopped_by_user.flag

*.bak
app/data/*.jsonl
app/data/*.bak
logs/*.log

# mission/DASHBOARD.md — local-only secrets, never committed
account_profiles.env
dashboard/.env
watchdog/.env
